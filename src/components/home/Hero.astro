---















import { getConfigurationCollection } from "../../lib/utils";
import Anchor from "../common/Anchor.astro";

const { data: config } = await getConfigurationCollection();
---

<div
  class="relative overflow-hidden border-2 border-zag-dark bg-white shadow-[10px_10px_0_#222222] dark:border-zag-light dark:bg-zag-dark dark:shadow-[10px_10px_0_#ffffff]"
>
  <div class="absolute left-0 top-0 h-3 w-1/3 bg-[#FFDE59]" aria-hidden="true"></div>
  <div class="absolute left-1/3 top-0 h-3 w-1/3 bg-[#38B6FF]" aria-hidden="true"></div>
  <div class="absolute right-0 top-0 h-3 w-1/3 bg-[#7C3AED]" aria-hidden="true"></div>
  <div class="grid items-center gap-10 p-6 sm:p-10 lg:grid-cols-[240px_1fr] lg:p-12">
    <img
      src={config.hero.image}
      alt={`${config.hero.title} profile photo`}
      class="relative z-10 mx-auto h-44 w-44 shrink-0 rounded-full border-4 border-white object-cover shadow-[0_0_0_8px_#FFDE59,8px_8px_0_#38B6FF] sm:h-52 sm:w-52 lg:h-56 lg:w-56"
    />
    <div class="relative z-10 flex max-w-2xl flex-col items-center gap-6 lg:items-start">
      <h1
        class="text-4xl sm:text-5xl lg:text-6xl font-display font-semibold opsz text-center lg:text-left leading-tight"
      >
        {config.hero.title}
      </h1>
      <h2
        class="text-center text-2xl sm:text-3xl font-mono font-medium lg:text-left"
      >
        <span set:html={config.hero.subtitle} />
      </h2>
      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <Anchor url={config.hero.ctaUrl}>{config.hero.ctaText}</Anchor>
        {
          config.personal.linkedinProfile && (
            <Anchor url={config.personal.linkedinProfile} external>
              Connect on LinkedIn
            </Anchor>
          )
        }
        {
          config.personal.twitterProfile && (
            <Anchor url={config.personal.twitterProfile} external>
              Follow on X
            </Anchor>
          )
        }
      </div>
    </div>
  </div>
</div>

---















import Anchor from "./common/Anchor.astro";

export type Props = {
  title: string;
  description: string;
  url?: string;
  external?: boolean;
  githubUrl?: string;
  liveUrl?: string;
  tags: string[];
};

const { title, description, url, external, githubUrl, liveUrl, tags } =
  Astro.props;
---

<div
  class="relative flex h-full flex-col gap-4 overflow-hidden border-2 border-zag-dark bg-white p-5 shadow-[6px_6px_0_#222222] zag-transition hover:-translate-y-1 dark:border-zag-light dark:bg-zag-dark dark:shadow-[6px_6px_0_#ffffff]"
>
  <div class="absolute left-0 top-0 h-2 w-full bg-[linear-gradient(90deg,#FFDE59_0_33%,#38B6FF_33%_66%,#7C3AED_66%_100%)]" aria-hidden="true"></div>
  <div class="flex flex-col gap-3 sm:flex-row sm:justify-between">
    {
      url ? (
        <Anchor url={url} class="text-xl" external={external}>
          {title}
        </Anchor>
      ) : (
        <h2 class="text-xl font-medium">{title}</h2>
      )
    }
    <div class="flex gap-2">
      {
        githubUrl ? (
          <Anchor url={githubUrl} class="text-base" external>
            GitHub
          </Anchor>
        ) : null
      }
      {
        liveUrl ? (
          <Anchor url={liveUrl} class="text-base" external>
            Live
          </Anchor>
        ) : null
      }
    </div>
  </div>
  <p class="zag-text zag-transition leading-relaxed">
    {description}
  </p>
  <div class="flex flex-row flex-wrap gap-2">
    {
      tags.map((tag) => (
        <span class="border border-zag-dark bg-[#FFDE59] px-2 py-1 text-sm font-semibold text-zag-dark zag-transition dark:border-zag-light">
          {tag}
        </span>
      ))
    }
  </div>
</div>

---















import { getCollection } from "astro:content";
import Section from "../components/common/Section.astro";
import FeaturedProjects from "../components/home/FeaturedProjects.astro";
import Hero from "../components/home/Hero.astro";
import Layout from "../layouts/Layout.astro";
import { getConfigurationCollection } from "../lib/utils";

const { data: config } = await getConfigurationCollection();

const featuredProjects = (
  await getCollection("project", (e) => e.data.featured)
).map((e) => ({
  ...e.data,
  url: e.data.liveDemoUrl,
}));
---

<Layout>
  <Fragment slot="head">
    <title>{config.globalMeta.title}</title>
    <meta
      name="description"
      content={config.globalMeta.longDescription ?? config.globalMeta.description}
    />
    <meta property="og:title" content={config.globalMeta.title} />
    <meta
      property="og:description"
      content={config.globalMeta.description}
    />
    {config.globalMeta.keywords && (
      <meta name="keywords" content={config.globalMeta.keywords.join(", ")} />
    )}
    {config.globalMeta.cardImage && (
      <meta property="og:image" content={config.globalMeta.cardImage} />
    )}
    <meta property="og:url" content={config.site.baseUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={config.globalMeta.title} />
    <meta
      name="twitter:description"
      content={config.globalMeta.description}
    />
    {config.globalMeta.cardImage && (
      <meta name="twitter:image" content={config.globalMeta.cardImage} />
    )}
    <meta http-equiv="content-language" content="en" />
    <meta name="language" content="English" />
    <link rel="canonical" href={config.site.baseUrl} />
  </Fragment>
  <Section class="my-20">
    <Hero />
  </Section>
  <Section class="my-16">
    <div class="grid gap-8 border-2 border-zag-dark bg-[#FFF2B8] p-6 shadow-[6px_6px_0_#222222] dark:border-zag-light dark:bg-[#5A4A12] dark:shadow-[6px_6px_0_#ffffff] lg:grid-cols-[0.7fr_1.3fr] lg:p-8">
      <h3 class="font-display text-lg sm:text-xl leading-loose zag-text zag-transition">About Me</h3>
      <div class="flex flex-col gap-4 text-lg leading-relaxed zag-text zag-transition">
        <p>
          I build practical products around privacy, personal finance, asset visibility, and operational GDPR.
        </p>
        <p>
          I care about open software, Linux, and tools people can actually inspect, understand, modify, and own.
        </p>
        <p>
          Outside work, I spend a lot of time reading and watching lectures, interviews, and debates on philosophy, politics, history, Austrian economics, technology, data, and AI.
        </p>
        <p>
          I also love cooking, travelling, and discovering places through food.
        </p>
      </div>
    </div>
  </Section>
  <Section>
    <FeaturedProjects featuredProjects={featuredProjects} title="My Current Projects" />
  </Section>
  <Section class="my-16">
    <div class="grid gap-8 border-2 border-zag-dark bg-white p-6 shadow-[6px_6px_0_#38B6FF] dark:border-zag-light dark:bg-zag-dark lg:grid-cols-[0.7fr_1.3fr]">
      <h3 class="font-display text-lg sm:text-xl leading-loose">Founder Track</h3>
      <p class="zag-text zag-transition leading-relaxed">
        My work has moved through law, privacy, fintech operations, and startup building, but the consistent thread is entrepreneurship: finding messy problems, shaping them into products, and learning by shipping.
      </p>
    </div>
  </Section>
  <Section class="my-16">
    <div class="grid gap-8 border-2 border-zag-dark bg-[#E9D5FF] p-6 shadow-[6px_6px_0_#7C3AED] dark:border-zag-light dark:bg-[#2E1065] dark:text-zag-light lg:grid-cols-[0.7fr_1.3fr]">
      <h3 class="font-display text-lg sm:text-xl leading-loose">My Blog</h3>
      <div class="flex flex-col gap-4 text-lg leading-relaxed">
        <p>
          I write about entrepreneurship, privacy, fintech, AI, legal stuff, and what it actually feels like to build products.
        </p>
        <p>
          This blog mixes notes from my own projects with essays on technology, data protection, financial privacy, and the trade-offs of modern digital life. The underlying lens is simple: I care about individual freedom, distrust concentrated power, and see the State less as a necessary evil than as a problem we too often excuse.
        </p>
      </div>
    </div>
  </Section>
</Layout>
